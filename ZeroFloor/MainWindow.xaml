<Window x:Class="ZeroFloor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZeroFloor"
        xmlns:controls="clr-namespace:ZeroFloor.Views.Controls"
        mc:Ignorable="d"
        Title="Нулевой этаж"
        Width="1600" Height="900"
        MinWidth="1024" MinHeight="576"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <!--
        Основной холст интерфейса спроектирован под 1920x1080 (16:9) и масштабируется
        Viewbox'ом целиком, с сохранением пропорций, под любое другое разрешение окна —
        от этого же холста наследуют размеры и все вложенные экраны/контролы.
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Background="{StaticResource BackgroundBrush}">

            <!-- Навигационная оболочка: содержимое подставляется DataTemplate'ами
                 из Views/ViewTemplates.xaml по типу текущей ViewModel. -->
            <ContentControl Content="{Binding CurrentViewModel}"/>

            <!-- Общие для всего приложения оверлеи (см. ShellViewModel). -->
            <controls:LoadingOverlayControl/>
            <controls:NotificationToastControl/>
            <controls:ConfirmationDialogControl/>
        </Grid>
    </Viewbox>
</Window>
