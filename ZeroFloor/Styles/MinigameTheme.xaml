<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Дизайн-система мини-игр и игрового интерфейса новеллы: тёмное «стекло», янтарный акцент
        (как HUD 3D-эпизодов), бирюзовый вторичный, единая типографика. Все оверлеи мини-игр
        собираются из этих стилей, чтобы выглядеть одним продуктом.
    -->

    <FontFamily x:Key="MgFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MgTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MgMono">Cascadia Mono, Consolas</FontFamily>

    <Color x:Key="MgAccentColor">#F2B347</Color>
    <SolidColorBrush x:Key="MgAccent" Color="#F2B347"/>
    <SolidColorBrush x:Key="MgAccentSoft" Color="#33F2B347"/>
    <SolidColorBrush x:Key="MgAccentDeep" Color="#8A5C16"/>
    <SolidColorBrush x:Key="MgCyan" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="MgGreen" Color="#4FD1A6"/>
    <SolidColorBrush x:Key="MgGreenSoft" Color="#334FD1A6"/>
    <SolidColorBrush x:Key="MgRed" Color="#FF5A4A"/>
    <SolidColorBrush x:Key="MgRedSoft" Color="#33FF5A4A"/>
    <SolidColorBrush x:Key="MgText" Color="#F2F5F8"/>
    <SolidColorBrush x:Key="MgMuted" Color="#9AA6B5"/>
    <SolidColorBrush x:Key="MgFaint" Color="#5E6878"/>
    <SolidColorBrush x:Key="MgLine" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="MgTrackBg" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="MgInset" Color="#66050709"/>

    <!-- фон под оверлеем: затемнение с мягким центром -->
    <RadialGradientBrush x:Key="MgScrim" RadiusX="0.85" RadiusY="0.9">
        <GradientStop Color="#C40C1016" Offset="0"/>
        <GradientStop Color="#F205070A" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="MgCardBg" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#F5141A24" Offset="0"/>
        <GradientStop Color="#F70B0F15" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MgAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFC766" Offset="0"/>
        <GradientStop Color="#F29A2E" Offset="1"/>
    </LinearGradientBrush>

    <!-- карточка мини-игры -->
    <Style x:Key="MgCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MgCardBg}"/>
        <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="48,40,48,36"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="60" ShadowDepth="14" Opacity="0.65" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- внутренняя «панель приборов» -->
    <Style x:Key="MgInsetPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MgInset}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MgLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="22,18"/>
    </Style>

    <Style x:Key="MgEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MgAccent}"/>
    </Style>

    <Style x:Key="MgTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MgText}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="MgBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgTextFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource MgMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="24"/>
    </Style>

    <Style x:Key="MgLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MgFaint}"/>
    </Style>

    <Style x:Key="MgValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MgText}"/>
    </Style>

    <Style x:Key="MgHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgTextFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource MgMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MgKeyCap" TargetType="Border">
        <Setter Property="Background" Value="#1FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MgKeyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MgText}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- полоса-трек и разделитель -->
    <Style x:Key="MgTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MgTrackBg}"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="MgDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource MgLine}"/>
        <Setter Property="Margin" Value="0,22"/>
    </Style>

    <!-- кнопки -->
    <Style x:Key="MgPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1A1206"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="30,13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource MgAccentGradient}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#F2B347"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MgGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MgFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MgText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="22,11"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#12FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MgAccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#55F2B347"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- круглая кнопка-иконка (вращение кольца, крестовина) -->
    <Style x:Key="MgRoundButton" TargetType="Button">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource MgText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="28">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MgAccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#66F2B347"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- экран провала с повтором (WirePuzzle/StealthGrid) -->
    <Style x:Key="MgFailTitle" TargetType="TextBlock" BasedOn="{StaticResource MgTitle}">
        <Setter Property="Foreground" Value="#FF8A7A"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="30"/>
    </Style>
</ResourceDictionary>
