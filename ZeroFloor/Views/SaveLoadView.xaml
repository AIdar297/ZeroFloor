<UserControl x:Class="ZeroFloor.Views.SaveLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{StaticResource StageBackgroundBrush}">
    <Grid Margin="140,90,140,70">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" FontSize="32"
                   Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" Style="{StaticResource ThemedScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SlotButtonStyle}" Content="{Binding}" Command="{Binding SelectCommand}"
                                Height="170" Margin="0,0,20,20">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SlotTitleTextStyle}"/>
                                        <TextBlock Text="{Binding TimestampText}" Style="{StaticResource SlotSubTextStyle}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SlotSubTextStyle}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LocationText}" Style="{StaticResource SlotSubTextStyle}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40"/>
                                        <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource SlotSubTextStyle}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding EndingText}" Style="{StaticResource SlotSubTextStyle}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding EndingText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Назад" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BackCommand}"
                HorizontalAlignment="Left" Margin="0,24,0,0"/>
    </Grid>
</UserControl>
