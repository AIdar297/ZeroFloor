<UserControl x:Class="ZeroFloor.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Loaded="OnLoaded">
    <Grid x:Name="RootGrid" Background="{StaticResource StageBackgroundBrush}">
        <!-- Декоративные индустриальные элементы фона — условные "балки", без растровых файлов;
             скрываются, если удалось подключить настоящий фон (см. OnLoaded). -->
        <Canvas x:Name="DecorCanvas" IsHitTestVisible="False">
            <Line X1="0" Y1="120" X2="1920" Y2="40" Stroke="{StaticResource BorderBrush}" StrokeThickness="2" Opacity="0.5"/>
            <Line X1="0" Y1="960" X2="1920" Y2="1040" Stroke="{StaticResource BorderBrush}" StrokeThickness="2" Opacity="0.5"/>
            <Line X1="1500" Y1="0" X2="1620" Y2="1080" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Opacity="0.3"/>
            <Line X1="1680" Y1="0" X2="1800" Y2="1080" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Opacity="0.3"/>
        </Canvas>

        <Grid Margin="115,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="600">
            <!-- Затемняющая подложка за пунктами меню — требование "кнопки как на референсе"
                 вместе с требованиями раздела о фонах ("не изменяй фон") оставляют только
                 программный путь отделить настоящее (кликабельное) меню от любого текста,
                 нарисованного прямо на фоновом изображении (у main_menu.png в кадре уже
                 есть свой — нефункциональный — список пунктов): тёмная полупрозрачная панель
                 за реальными кнопками, с плавным затуханием к краю, а не правка самого файла. -->
            <Border x:Name="MenuScrim" Margin="-24,-16,-32,-30" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0B0E14" Offset="0"/>
                        <GradientStop Color="#0B0E14" Offset="0.9"/>
                        <GradientStop Color="#000B0E14" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Grid, не StackPanel: внутри StackPanel (вертикального) дочерние элементы
                 измеряются с "бесконечной" доступной шириной и получают только свой
                 естественный (по тексту) размер — HorizontalAlignment="Stretch" у кнопки
                 тогда ни на что не растягивается. Grid со строками Auto действительно
                 растягивает каждую строку на всю ширину колонки — отсюда и подсветка
                 "от края до края", как на референсе, а не только под текстом. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TitleText" Text="НУЛЕВОЙ ЭТАЖ" Style="{StaticResource HeadingTextStyle}"/>
                <TextBlock Grid.Row="1" x:Name="SubtitleText" Text="визуальная новелла" Style="{StaticResource SubheadingTextStyle}" Margin="0,4,0,48"/>

                <Button Grid.Row="2" x:Name="NewGameButton" Content="НОВАЯ ИГРА" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding NewGameCommand}"/>
                <Button Grid.Row="3" Content="ПРОДОЛЖИТЬ" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding ContinueGameCommand}"/>
                <Button Grid.Row="4" Content="ЗАГРУЗИТЬ" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding LoadGameCommand}"/>
                <Button Grid.Row="5" Content="ГАЛЕРЕЯ" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding GalleryCommand}"/>
                <Button Grid.Row="6" Content="НАСТРОЙКИ" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding SettingsCommand}"/>
                <Button Grid.Row="7" Content="ВЫХОД" Style="{StaticResource MainMenuButtonStyle}" Command="{Binding ExitCommand}"/>
            </Grid>
        </Grid>

        <TextBlock Text="сборка-основа · контент ещё не перенесён" Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Opacity="0.6"/>
    </Grid>
</UserControl>
