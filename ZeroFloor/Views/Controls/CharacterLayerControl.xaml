<UserControl x:Class="ZeroFloor.Views.Controls.CharacterLayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             IsHitTestVisible="False">
    <!--
        Область отображения персонажей. Реальных изображений ещё нет (будут переданы отдельно —
        см. CLAUDE.md), поэтому силуэты нарисованы средствами WPF (без растровых файлов).
        Контрол может держать НЕСКОЛЬКО персонажей одновременно (по CharacterId) — каждый
        со своим TranslateTransform/ScaleTransform, которыми управляет ICharacterAnimationService.
        Один персонаж = одно статичное изображение в будущем; вся "жизнь" — программные
        Opacity/Scale/Translate поверх него, без кадров и смены поз (см. CLAUDE.md).
    -->
    <Grid x:Name="Stage"/>
</UserControl>
