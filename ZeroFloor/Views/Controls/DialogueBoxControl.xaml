<UserControl x:Class="ZeroFloor.Views.Controls.DialogueBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding IsUiHidden, Converter={StaticResource InverseBoolToVisibilityConverter}}">
    <UserControl.Resources>
        <!-- Рассказчик — без «таблички» говорящего, текст курсивом и чуть приглушённый;
             персонаж — янтарная табличка с именем. -->
        <Style x:Key="LineText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MgTextFont}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="LineHeight" Value="38"/>
            <Setter Property="Foreground" Value="#F0F3F7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpeakerName}" Value="Рассказчик">
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="Foreground" Value="#D6DCE4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NameTag" TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpeakerName}" Value="Рассказчик">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NarratorTag" TargetType="TextBlock" BasedOn="{StaticResource MgLabel}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#8C97A8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpeakerName}" Value="Рассказчик">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="Bounce" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ChevronMove" Storyboard.TargetProperty="Y" From="0" To="5" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- мягкое затемнение низа экрана — текст читается на любом фоне -->
        <Border VerticalAlignment="Bottom" Height="430" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="0.55"/>
                    <GradientStop Color="#E6000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid VerticalAlignment="Bottom" Margin="150,0,150,40">
            <Border x:Name="PanelBorder" CornerRadius="24" MinHeight="196" Cursor="Hand"
                    BorderBrush="#33FFFFFF" BorderThickness="1"
                    MouseLeftButtonUp="OnDialogueBoxClicked">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E0121820" Offset="0"/>
                        <GradientStop Color="#F00A0D12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <!-- подкраска под цвет фона сцены (SetSceneTint), поверх стекла и полупрозрачно -->
                    <Border x:Name="TintLayer" CornerRadius="24" Opacity="0.35"/>
                    <!-- верхний блик стекла -->
                    <Border CornerRadius="24,24,0,0" Height="60" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#14FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- акцентная линия слева -->
                    <Border Width="4" HorizontalAlignment="Left" Margin="0,30" CornerRadius="2" Background="{StaticResource MgAccentGradient}" Opacity="0.85"/>

                    <Grid Margin="46,30,40,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource NameTag}" Background="{StaticResource MgAccentSoft}" BorderBrush="#66F2B347" BorderThickness="1" CornerRadius="10" Padding="14,5">
                                <TextBlock Text="{Binding SpeakerName}" FontFamily="{StaticResource MgFont}" FontSize="19" FontWeight="SemiBold" Foreground="#FFD58A"/>
                            </Border>
                            <TextBlock Text="— РАССКАЗЧИК —" Style="{StaticResource NarratorTag}" VerticalAlignment="Center"/>
                            <Button Content="🔊" Style="{StaticResource MgRoundButton}" Width="36" Height="36" FontSize="14"
                                    Margin="10,0,0,0" ToolTip="Повторить озвучку реплики"
                                    Command="{Binding ReplayVoiceCommand}"
                                    Visibility="{Binding CanReplayVoice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding LineText}" Style="{StaticResource LineText}" VerticalAlignment="Top"/>

                        <!-- продолжение: подсказка клавиши и пульсирующая стрелка -->
                        <Button Grid.Row="2" Command="{Binding ContinueCommand}" HorizontalAlignment="Right" Cursor="Hand" Margin="0,14,0,0"
                                Visibility="{Binding IsChoiceVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MgKeyCap}"><TextBlock Text="Пробел" Style="{StaticResource MgKeyText}"/></Border>
                                <TextBlock Text="Далее" Style="{StaticResource MgHint}" Foreground="#C9D2DC" Margin="0,0,10,0"/>
                                <TextBlock Text="▾" FontSize="20" Foreground="{StaticResource MgAccent}" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="ChevronMove"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
