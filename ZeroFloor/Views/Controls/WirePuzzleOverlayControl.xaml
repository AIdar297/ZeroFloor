<UserControl x:Class="ZeroFloor.Views.Controls.WirePuzzleOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding ActiveMinigame, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True">
    <UserControl.Resources>
        <!-- Плитка-проводник: тёмная металлическая ячейка, сама «труба» светится янтарём. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="14" BorderBrush="#2EFFFFFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E2530" Offset="0"/>
                                    <GradientStop Color="#121820" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Port" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource MgGreen}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#4FD1A6" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MgScrim}" DataContext="{Binding ActiveMinigame}">
        <Border Style="{StaticResource MgCard}" Width="980">
            <StackPanel>
                <TextBlock Text="ПАНЕЛЬ ЛИФТОВОГО УЗЛА" Style="{StaticResource MgEyebrow}"/>
                <TextBlock Text="Взлом панели" Style="{StaticResource MgTitle}"/>
                <TextBlock Style="{StaticResource MgBody}" Margin="0,8,0,0"
                           Text="Замкните цепь от входа к выходу, пока не подошёл патруль. Нажимайте на плитки, чтобы поворачивать их."/>

                <Grid Margin="0,22,0,6">
                    <TextBlock Text="ПАТРУЛЬ ПРИБЛИЖАЕТСЯ" Style="{StaticResource MgLabel}" Foreground="#FF8A7A"/>
                </Grid>
                <Grid Height="8" Margin="0,0,0,26">
                    <Border Style="{StaticResource MgTrack}" CornerRadius="4"/>
                    <Border CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource MgRed}"
                            Width="{Binding Progress, Converter={StaticResource FractionToWidthConverter}, ConverterParameter=882}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF5A4A" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <Border Style="{StaticResource MgInsetPanel}" HorizontalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="{Binding StartRow}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ВХОД" Style="{StaticResource MgLabel}" Foreground="{StaticResource MgGreen}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource Port}"/>
                        </StackPanel>

                        <ItemsControl Grid.Column="1" Grid.RowSpan="3" ItemsSource="{Binding Tiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="3" Columns="{Binding Cols}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding RotateCommand}" Style="{StaticResource TileButton}">
                                        <Path x:Name="PipePath" Width="84" Height="84" Stroke="{StaticResource MgAccentGradient}" StrokeThickness="12"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#F2B347" Opacity="0.7"/>
                                            </Path.Effect>
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding RotationAngle}" CenterX="42" CenterY="42"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Shape}" Value="Straight">
                                            <Setter TargetName="PipePath" Property="Data" Value="M42,0 L42,84"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Shape}" Value="Elbow">
                                            <Setter TargetName="PipePath" Property="Data" Value="M42,0 L42,42 L84,42"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="2" Grid.Row="{Binding EndRow}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ВЫХОД" Style="{StaticResource MgLabel}" Foreground="{StaticResource MgGreen}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource Port}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- провал: повтор сцены -->
        <Grid Background="#E6120708" Visibility="{Binding IsGameOverVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource MgCard}" Width="720" BorderBrush="#66FF5A4A">
                <StackPanel>
                    <TextBlock Text="ДОСТУП ЗАБЛОКИРОВАН" Style="{StaticResource MgEyebrow}" Foreground="#FF8A7A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Система всегда узнаёт о тебе раньше, чем ты о последствиях" Style="{StaticResource MgFailTitle}" Margin="0,10,0,26"/>
                    <Button Content="Перезагрузить чип" Style="{StaticResource MgPrimaryButton}" Command="{Binding RetryCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
