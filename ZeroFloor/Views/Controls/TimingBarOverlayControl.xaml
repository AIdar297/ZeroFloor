<UserControl x:Class="ZeroFloor.Views.Controls.TimingBarOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding ActiveTimingBarMinigame, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True">
    <Grid Background="{StaticResource MgScrim}" DataContext="{Binding ActiveTimingBarMinigame}">
        <Border Style="{StaticResource MgCard}" Width="900">
            <StackPanel>
                <TextBlock Text="ГЛАВА 2 · ПРИЛАВОК ГОШИ" Style="{StaticResource MgEyebrow}"/>
                <TextBlock Text="Кража обходчика" Style="{StaticResource MgTitle}"/>
                <TextBlock Style="{StaticResource MgBody}" Margin="0,8,0,0"
                           Text="Гоша отвлёкся на скандального покупателя. Поймайте момент, когда его внимание действительно ушло в сторону — ползунок в зелёной зоне — и спрячьте чип в рукав."/>

                <Border Style="{StaticResource MgDivider}"/>

                <!-- Шкала внимания: координаты зон и ползунка — из TimingBarViewModel (трек 700 px). -->
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Width="700" Margin="0,0,0,10">
                        <TextBlock Text="ГОША СМОТРИТ" Style="{StaticResource MgLabel}" Foreground="#FF8A7A" HorizontalAlignment="Left"/>
                        <TextBlock Text="ОТВЛЁКСЯ" Style="{StaticResource MgLabel}" Foreground="{StaticResource MgGreen}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ГОША СМОТРИТ" Style="{StaticResource MgLabel}" Foreground="#FF8A7A" HorizontalAlignment="Right"/>
                    </Grid>

                    <Canvas Grid.Row="1" Width="700" Height="64">
                        <Rectangle Width="700" Height="40" Canvas.Top="12" RadiusX="12" RadiusY="12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5A1C18" Offset="0"/>
                                    <GradientStop Color="#3A1512" Offset="0.5"/>
                                    <GradientStop Color="#5A1C18" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="{Binding YellowLeftZoneLeft}" Canvas.Top="12" Width="{Binding YellowZoneWidthValue}" Height="40" Fill="#88F2B347"/>
                        <Rectangle Canvas.Left="{Binding YellowRightZoneLeft}" Canvas.Top="12" Width="{Binding YellowZoneWidthValue}" Height="40" Fill="#88F2B347"/>
                        <Rectangle Canvas.Left="{Binding GreenZoneLeft}" Canvas.Top="12" Width="{Binding GreenZoneWidth}" Height="40">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7CF2C8" Offset="0"/>
                                    <GradientStop Color="#2FA67E" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#4FD1A6" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Rectangle Width="700" Height="40" Canvas.Top="12" RadiusX="12" RadiusY="12" Stroke="#33FFFFFF" StrokeThickness="1"/>
                        <!-- ползунок -->
                        <Rectangle Canvas.Left="{Binding MarkerX}" Width="{Binding MarkerWidthValue}" Height="64" RadiusX="5" RadiusY="5" Fill="White">
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="White" Opacity="0.9"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Canvas>

                    <!-- риски шкалы -->
                    <Canvas Grid.Row="2" Width="700" Height="14" Margin="0,8,0,0">
                        <Rectangle Canvas.Left="0" Width="1" Height="8" Fill="#40FFFFFF"/>
                        <Rectangle Canvas.Left="87" Width="1" Height="5" Fill="#30FFFFFF"/>
                        <Rectangle Canvas.Left="175" Width="1" Height="8" Fill="#40FFFFFF"/>
                        <Rectangle Canvas.Left="262" Width="1" Height="5" Fill="#30FFFFFF"/>
                        <Rectangle Canvas.Left="350" Width="1" Height="10" Fill="#60FFFFFF"/>
                        <Rectangle Canvas.Left="437" Width="1" Height="5" Fill="#30FFFFFF"/>
                        <Rectangle Canvas.Left="525" Width="1" Height="8" Fill="#40FFFFFF"/>
                        <Rectangle Canvas.Left="612" Width="1" Height="5" Fill="#30FFFFFF"/>
                        <Rectangle Canvas.Left="699" Width="1" Height="8" Fill="#40FFFFFF"/>
                    </Canvas>
                </Grid>

                <Grid Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource MgKeyCap}"><TextBlock Text="Пробел" Style="{StaticResource MgKeyText}"/></Border>
                        <TextBlock Text="или кнопка — одна попытка, ошибка не прощается" Style="{StaticResource MgHint}"/>
                    </StackPanel>
                    <Button Content="Спрятать чип" Style="{StaticResource MgPrimaryButton}" Command="{Binding PressCommand}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
