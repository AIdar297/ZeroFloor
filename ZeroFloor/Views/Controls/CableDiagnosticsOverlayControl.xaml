<UserControl x:Class="ZeroFloor.Views.Controls.CableDiagnosticsOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding ActiveCableDiagnostics, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True">
    <Grid Background="{StaticResource MgScrim}" DataContext="{Binding ActiveCableDiagnostics}">
        <Border Style="{StaticResource MgCard}" Width="980">
            <StackPanel>
                <TextBlock Text="ГЛАВА 1 · ДИСПЕТЧЕРСКАЯ №6 · ШАХТА 14" Style="{StaticResource MgEyebrow}"/>
                <TextBlock Text="Диагностика троса" Style="{StaticResource MgTitle}"/>
                <TextBlock Style="{StaticResource MgBody}" Margin="0,8,0,0"
                           Text="Натяжение само сползает и дрожит. Подкачивайте насос и удерживайте стрелку в зелёном секторе, пока трос не стабилизируется. Попытка одна."/>
                <Border Style="{StaticResource MgDivider}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Манометр натяжения: трек 140×480, зоны и стрелка — координаты из ViewModel. -->
                    <Border Style="{StaticResource MgInsetPanel}" Padding="22" Margin="0,0,36,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Height="480" Margin="0,0,12,0">
                                <TextBlock Text="МАКС" Style="{StaticResource MgLabel}" VerticalAlignment="Top"/>
                                <TextBlock Text="НОРМА" Style="{StaticResource MgLabel}" Foreground="{StaticResource MgGreen}" VerticalAlignment="Center"/>
                                <TextBlock Text="ОБРЫВ" Style="{StaticResource MgLabel}" Foreground="#FF8A7A" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Canvas Grid.Column="1" Width="140" Height="480" ClipToBounds="True">
                                <Rectangle Width="140" Height="480" RadiusX="16" RadiusY="16">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A1A16" Offset="0"/>
                                            <GradientStop Color="#2A1210" Offset="0.5"/>
                                            <GradientStop Color="#4A1A16" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Canvas.Top="{Binding YellowZoneTop}" Width="140" Height="{Binding YellowZoneHeight}" Fill="#66F2B347"/>
                                <Rectangle Canvas.Top="{Binding GreenZoneTop}" Width="140" Height="{Binding GreenZoneHeight}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2FA67E" Offset="0"/>
                                            <GradientStop Color="#7CF2C8" Offset="0.5"/>
                                            <GradientStop Color="#2FA67E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- риски -->
                                <Rectangle Canvas.Top="48" Canvas.Left="0" Width="16" Height="1" Fill="#40FFFFFF"/>
                                <Rectangle Canvas.Top="96" Canvas.Left="0" Width="24" Height="1" Fill="#55FFFFFF"/>
                                <Rectangle Canvas.Top="144" Canvas.Left="0" Width="16" Height="1" Fill="#40FFFFFF"/>
                                <Rectangle Canvas.Top="192" Canvas.Left="0" Width="24" Height="1" Fill="#55FFFFFF"/>
                                <Rectangle Canvas.Top="240" Canvas.Left="0" Width="32" Height="1" Fill="#77FFFFFF"/>
                                <Rectangle Canvas.Top="288" Canvas.Left="0" Width="24" Height="1" Fill="#55FFFFFF"/>
                                <Rectangle Canvas.Top="336" Canvas.Left="0" Width="16" Height="1" Fill="#40FFFFFF"/>
                                <Rectangle Canvas.Top="384" Canvas.Left="0" Width="24" Height="1" Fill="#55FFFFFF"/>
                                <Rectangle Canvas.Top="432" Canvas.Left="0" Width="16" Height="1" Fill="#40FFFFFF"/>
                                <!-- стрелка -->
                                <Rectangle Canvas.Top="{Binding NeedleTop}" Width="140" Height="6" RadiusX="3" RadiusY="3" Fill="White">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="White" Opacity="0.9"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- табло натяжения -->
                        <Border Style="{StaticResource MgInsetPanel}" Margin="0,0,0,30" Padding="24,16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="НАТЯЖЕНИЕ ТРОСА" Style="{StaticResource MgLabel}"/>
                                    <TextBlock Text="{Binding Tension, StringFormat={}{0:P0}}" FontFamily="{StaticResource MgFont}" FontSize="64" FontWeight="Bold" Foreground="{StaticResource MgText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="НОРМА" Style="{StaticResource MgLabel}" HorizontalAlignment="Right"/>
                                    <TextBlock FontFamily="{StaticResource MgFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MgGreen}" HorizontalAlignment="Right">
                                        <Run Text="{Binding GreenMin, Mode=OneWay, StringFormat={}{0:P0}}"/><Run Text=" – "/><Run Text="{Binding GreenMax, Mode=OneWay, StringFormat={}{0:P0}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock Text="СТАБИЛИЗАЦИЯ" Style="{StaticResource MgLabel}"/>
                            <TextBlock Style="{StaticResource MgLabel}" Foreground="{StaticResource MgGreen}" HorizontalAlignment="Right"
                                       Text="{Binding StableProgress, StringFormat={}{0:P0}}"/>
                        </Grid>
                        <Grid Height="12" Margin="0,10,0,26">
                            <Border Style="{StaticResource MgTrack}"/>
                            <Border CornerRadius="5" HorizontalAlignment="Left" Background="{StaticResource MgGreen}"
                                    Width="{Binding StableProgress, Converter={StaticResource FractionToWidthConverter}, ConverterParameter=470}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#4FD1A6" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <Grid>
                            <TextBlock Text="ВРЕМЯ СМЕНЫ" Style="{StaticResource MgLabel}"/>
                        </Grid>
                        <Grid Height="6" Margin="0,10,0,34">
                            <Border Style="{StaticResource MgTrack}" CornerRadius="3"/>
                            <Border CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource MgAccent}"
                                    Width="{Binding SessionProgress, Converter={StaticResource FractionToWidthConverter}, ConverterParameter=470}"/>
                        </Grid>

                        <!-- Насос: удержание (мышь или Пробел) -->
                        <Button x:Name="PumpButton" Style="{StaticResource MgPrimaryButton}" Padding="30,22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="НАСОС" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="держите, чтобы поднять натяжение" FontSize="13" FontWeight="Normal" Opacity="0.75" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MgKeyCap}"><TextBlock Text="Пробел" Style="{StaticResource MgKeyText}"/></Border>
                                <TextBlock Text="удерживать" Style="{StaticResource MgHint}"/>
                            </StackPanel>
                            <Button Content="Пропустить проверку" Style="{StaticResource MgGhostButton}" Command="{Binding SkipCommand}" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
