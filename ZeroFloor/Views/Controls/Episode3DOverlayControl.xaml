<UserControl x:Class="ZeroFloor.Views.Controls.Episode3DOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding ActiveEpisode, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True" Background="Black">
    <UserControl.Resources>
        <FontFamily x:Key="HudFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="GlassBrush" Color="#B30A0E14"/>
        <SolidColorBrush x:Key="GlassStroke" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="HudText" Color="#F2F5F8"/>
        <SolidColorBrush x:Key="HudMuted" Color="#9AA6B5"/>
        <SolidColorBrush x:Key="HudAccent" Color="#F2B347"/>

        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
            <Setter Property="Foreground" Value="{StaticResource HudMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PauseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource HudText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="22,13">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33F2B347"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F2B347"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PauseCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource HudText}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="46" Height="24" CornerRadius="12" Background="#33FFFFFF">
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#F2B347"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PauseSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Foreground" Value="#F2B347"/>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- 3D-сцена -->
        <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- виньетка (всегда, для глубины кадра) -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- тревога: красная пульсирующая виньетка -->
        <Border x:Name="AlarmVignette" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush RadiusX="0.7" RadiusY="0.75">
                    <GradientStop Color="#00FF1E1E" Offset="0.45"/>
                    <GradientStop Color="#CCD01010" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- вспышка урона -->
        <Border x:Name="DamageFlash" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush RadiusX="0.7" RadiusY="0.75">
                    <GradientStop Color="#00FF0000" Offset="0.3"/>
                    <GradientStop Color="#EEB00000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ================= HUD ================= -->
        <Grid x:Name="HudRoot" IsHitTestVisible="False" Margin="44,38">

            <!-- цель -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource GlassBrush}"
                    BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" CornerRadius="12" MaxWidth="460">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource HudAccent}" CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="20,14,22,16">
                        <TextBlock Text="ЦЕЛЬ" Style="{StaticResource HudLabel}" Foreground="{StaticResource HudAccent}" FontSize="12"/>
                        <TextBlock x:Name="ObjectiveTitle" FontFamily="{StaticResource HudFont}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource HudText}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ObjectiveDetail" FontFamily="{StaticResource HudFont}" FontSize="15"
                                   Foreground="{StaticResource HudMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- индикаторы справа сверху -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="330">
                <Border x:Name="DetectionPanel" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassStroke}"
                        BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ОБНАРУЖЕНИЕ" Style="{StaticResource HudLabel}"/>
                            <TextBlock x:Name="DetectionLabel" Style="{StaticResource HudLabel}" HorizontalAlignment="Right" Foreground="{StaticResource HudText}"/>
                        </Grid>
                        <Grid Height="8" Margin="0,9,0,0">
                            <Border Background="#22FFFFFF" CornerRadius="4"/>
                            <Border x:Name="DetectionFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="#4FD1A6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="PursuitPanel" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassStroke}"
                        BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ПРЕСЛЕДОВАНИЕ" Style="{StaticResource HudLabel}"/>
                            <TextBlock x:Name="PursuitLabel" Style="{StaticResource HudLabel}" HorizontalAlignment="Right" Foreground="{StaticResource HudText}"/>
                        </Grid>
                        <Grid Height="8" Margin="0,9,0,0">
                            <Border Background="#22FFFFFF" CornerRadius="4"/>
                            <Border x:Name="PursuitFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="#FF4A3D"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="VitalsPanel" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassStroke}"
                        BorderThickness="1" CornerRadius="12" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="МАКС" Style="{StaticResource HudLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Grid Grid.Column="1" Height="6">
                            <Border Background="#22FFFFFF" CornerRadius="3"/>
                            <Border x:Name="VitalsFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#E8EEF4"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- баннер участка -->
            <StackPanel x:Name="BannerPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0" Opacity="0">
                <TextBlock x:Name="BannerTitle" FontFamily="{StaticResource HudFont}" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource HudText}" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Border Height="2" Width="120" Background="{StaticResource HudAccent}" Margin="0,10,0,10" CornerRadius="1"/>
                <TextBlock x:Name="BannerSubtitle" FontFamily="{StaticResource HudFont}" FontSize="18"
                           Foreground="#D9E2EA" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- предупреждение + подсказка действия + тост -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
                <Border x:Name="WarningPanel" Background="#CC2A1405" BorderBrush="#F2B347" BorderThickness="1"
                        CornerRadius="20" Padding="18,8" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="18" Foreground="{StaticResource HudAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WarningText" FontFamily="{StaticResource HudFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#FFE2B0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PromptPanel" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassStroke}"
                        BorderThickness="1" CornerRadius="22" Padding="10,8,18,8" HorizontalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource KeyCap}" Background="#F2B347" BorderBrush="#FFD58A">
                            <TextBlock Text="E" FontFamily="{StaticResource HudFont}" FontWeight="Bold" FontSize="15" Foreground="#1A1206" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PromptText" FontFamily="{StaticResource HudFont}" FontSize="17" Foreground="{StaticResource HudText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ToastText" FontFamily="{StaticResource HudFont}" FontSize="17" Foreground="#E6ECF2"
                           HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0" TextAlignment="Center" MaxWidth="760" TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- подсказки управления -->
            <ItemsControl x:Name="ControlsList" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.85">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Border Style="{StaticResource KeyCap}">
                                <TextBlock Text="{Binding Key}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Label}" FontFamily="Segoe UI" FontSize="13" Foreground="#C9D2DC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- затемнение для входа/выхода -->
        <Border x:Name="FadeOverlay" Background="Black" Opacity="1" IsHitTestVisible="False"/>

        <!-- ================= ПАУЗА ================= -->
        <Grid x:Name="PausePanel" Visibility="Collapsed" Background="#C8060910">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Background="#F00E131B"
                    BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="18" Padding="40,34">
                <StackPanel DataContext="{Binding ActiveEpisode}">
                    <TextBlock Text="ПАУЗА" Style="{StaticResource HudLabel}" Foreground="{StaticResource HudAccent}"/>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HudFont}" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource HudText}" Margin="0,2,0,24"/>

                    <Button Content="Продолжить" Style="{StaticResource PauseButton}" Click="OnResumeClick"/>

                    <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource HudLabel}" Margin="0,16,0,8"/>
                    <Grid>
                        <TextBlock Text="Чувствительность мыши" FontFamily="{StaticResource HudFont}" FontSize="16" Foreground="{StaticResource HudText}"/>
                        <TextBlock Text="{Binding MouseSensitivity, StringFormat={}{0:0.0}×}" FontFamily="{StaticResource HudFont}" FontSize="16"
                                   Foreground="{StaticResource HudMuted}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0.2" Maximum="3" Value="{Binding MouseSensitivity, Mode=TwoWay}" Style="{StaticResource PauseSlider}"/>
                    <Grid>
                        <TextBlock Text="Громкость эффектов" FontFamily="{StaticResource HudFont}" FontSize="16" Foreground="{StaticResource HudText}"/>
                        <TextBlock Text="{Binding SfxVolume, StringFormat={}{0:P0}}" FontFamily="{StaticResource HudFont}" FontSize="16"
                                   Foreground="{StaticResource HudMuted}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding SfxVolume, Mode=TwoWay}" Style="{StaticResource PauseSlider}"/>
                    <CheckBox Content="Инвертировать ось Y" IsChecked="{Binding InvertY, Mode=TwoWay}" Style="{StaticResource PauseCheck}"/>
                    <CheckBox Content="Тряска камеры" IsChecked="{Binding CameraShake, Mode=TwoWay}" Style="{StaticResource PauseCheck}"/>
                    <CheckBox Content="Подсказки управления" IsChecked="{Binding ShowControlHints, Mode=TwoWay}" Style="{StaticResource PauseCheck}"/>

                    <Button Content="Выйти в главное меню" Style="{StaticResource PauseButton}" Margin="0,22,0,0"
                            Command="{Binding ExitToMenuCommand}" Foreground="#FF9A8A"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
