<UserControl x:Class="ZeroFloor.Views.Controls.ConfirmationDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding ActiveConfirmation, Converter={StaticResource NullToVisibilityConverter}}">
    <Grid Background="{StaticResource ScrimBrush}">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34">
            <StackPanel>
                <TextBlock Text="{Binding ActiveConfirmation.Title}" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="{Binding ActiveConfirmation.Message}" Style="{StaticResource BodyTextStyle}"
                           Margin="0,14,0,30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding ActiveConfirmation.CancelLabel}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ActiveConfirmation.CancelCommand}" Margin="0,0,14,0"/>
                    <Button Content="{Binding ActiveConfirmation.ConfirmLabel}" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding ActiveConfirmation.ConfirmCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
