<UserControl x:Class="ZeroFloor.Views.Controls.PauseMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Visibility="{Binding IsPauseMenuVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <Grid Background="{StaticResource ScrimBrush}">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
            <StackPanel>
                <TextBlock Text="ПАУЗА" Style="{StaticResource SectionHeaderTextStyle}"
                           HorizontalAlignment="Center" Margin="0,0,0,26"/>

                <Button Content="Продолжить" Style="{StaticResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Command="{Binding PauseMenu.ResumeCommand}"/>
                <Button Content="Сохранить" Style="{StaticResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Command="{Binding PauseMenu.SaveCommand}"/>
                <Button Content="Загрузить" Style="{StaticResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Command="{Binding PauseMenu.OpenLoadCommand}"/>
                <Button Content="Настройки" Style="{StaticResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Command="{Binding PauseMenu.OpenSettingsCommand}"/>
                <Button Content="В главное меню" Style="{StaticResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Command="{Binding PauseMenu.ExitToMenuCommand}"/>
                <Button Content="Выйти из игры" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding PauseMenu.ExitApplicationCommand}"
                        HorizontalAlignment="Stretch" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
